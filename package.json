{
  "name": "lari-kilat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Game platformer 2D web v1 — Next.js + TypeScript, render Canvas 2D, tanpa server.",
  "scripts": {
    "predev": "node scripts/sync-assets.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-assets.mjs",
    "build": "next build",
    "test": "node scripts/test.mjs && node --test qa/ pipeline/",
    "test:game": "node scripts/test.mjs",
    "test:qa": "node --test qa/",
    "test:pipeline": "node --test pipeline/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
